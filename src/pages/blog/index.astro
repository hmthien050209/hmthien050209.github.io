---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/Blogs/PostCard.astro';
import CardsContainer from '../../components/Blogs/CardsContainer.astro';
import { getCollection } from 'astro:content';
import { getImagePath } from 'astro-takumi/dist/util.js';

const posts = await getCollection('blog');
---

<BaseLayout
  title="Blogs"
  description="A collection of my blogs where I share my thoughts and experiences."
  isTextPrimary={false}
>
  <div class="my-4 flex flex-col items-center justify-center">
    <h1>My blogs</h1>
    <p>
      Here are the blogs I wrote in my spare time. Don't take them too seriously
      :)
    </p>
  </div>
  <CardsContainer>
    {
      posts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description || ''}
          date={post.data.date}
          url={`/blog/${post.id}`}
          ogImageUrl={getImagePath({
            url: new URL(`/blog/${post.id}/`, Astro.site),
            site: Astro.site,
            format: 'webp',
          })}
          {...(post.data.imageName ? { imageName: post.data.imageName } : {})}
        />
      ))
    }
  </CardsContainer>
</BaseLayout>
