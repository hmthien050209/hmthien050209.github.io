---
import type { ImageMetadata } from "astro";

interface Props {
  title?: string;
  description?: string;
  imageName?: string;
  ogImageUrl?: string;
  date: Date;
  url: string;
}

const { title, description, imageName, ogImageUrl, url, date } = Astro.props;

const images = import.meta.glob<{
  default: ImageMetadata;
}>("/src/assets/*.{jpeg,jpg,png,webp,svg,gif}");
const relativeImagePath = `/src/assets/${imageName}`;

let imageSrc: string | undefined;
if (imageName) {
  if (!images[relativeImagePath]) {
    throw new Error(
      `${relativeImagePath} does not exist in glob "/src/assets/*.{jpeg,jpg,png,webp,svg,gif}"`,
    );
  }
  imageSrc = (await images[relativeImagePath]!()).default.src;
} else if (ogImageUrl) {
  imageSrc = ogImageUrl;
}
---

<a href={url} data-astro-prefetch>
  {
    imageSrc && (
      <img src={imageSrc} alt={`Hero image for post "${title}"`} />
    )
  }
  <div class="post-details">
    <h3>{title}</h3>
    <p class="line-clamp-2">{description}</p>
  </div>
  <div class="post-date">
    <p class="my-0">{date.toDateString()}</p>
  </div>
</a>

<style>
  @reference '@styles/global.css';
  a {
    all: unset;
    @apply flex h-96 w-72 flex-col items-center justify-center;
    @apply hover:bg-background-hover dark:hover:bg-dark-background-hover relative rounded-xl bg-sub p-2 hover:cursor-pointer hover:text-inherit hover:no-underline dark:bg-dark-sub dark:hover:text-inherit;
    @apply motion-safe:transition-all motion-safe:duration-300 motion-safe:ease-out motion-safe:hover:scale-105;
  }

  img {
    @apply h-full w-full rounded-[calc(var(--radius-xl)-var(--spacing)*2)] object-cover m-0;
  }

  .post-details,
  .post-date {
    @apply w-full;
  }

  .post-details {
    @apply h-full;
  }

  .post-date {
    @apply h-16;
  }
</style>
